module Etcetera
  # Version of the gem, mirroring the version of the Rust crate it ports.
  VERSION: String

  # Base class for every error Etcetera raises.
  class Error < StandardError
  end

  # This error occurs when the home directory cannot be located.
  class HomeDirError < Error
    def initialize: (?String message) -> void
  end

  # The strategy Etcetera::BaseStrategy.choose_native_strategy returns.
  type native_base_strategy = BaseStrategy::Apple | BaseStrategy::Windows | BaseStrategy::Xdg

  # The strategy Etcetera::BaseStrategy.choose_base_strategy returns.
  type default_base_strategy = BaseStrategy::Windows | BaseStrategy::Xdg

  # The strategy Etcetera::AppStrategy.choose_native_strategy returns.
  type native_app_strategy = AppStrategy::Apple | AppStrategy::Windows | AppStrategy::Xdg

  # The strategy Etcetera::AppStrategy.choose_app_strategy returns.
  type default_app_strategy = AppStrategy::Windows | AppStrategy::Xdg

  # Shorthand for Etcetera::AppStrategy::AppStrategyArgs, mirroring the crate
  # root re-export this library ports.
  AppStrategyArgs: singleton(AppStrategy::AppStrategyArgs)

  # A convenience wrapper around Dir.home that returns a Pathname.
  def self.home_dir: () -> Pathname

  # Returns the current OS's default Etcetera::BaseStrategy.
  def self.choose_base_strategy: () -> default_base_strategy

  # Returns the current OS's default Etcetera::AppStrategy.
  def self.choose_app_strategy: (AppStrategy::AppStrategyArgs args) -> default_app_strategy
end
