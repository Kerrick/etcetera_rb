module Etcetera
  module AppStrategy
    class Xdg < Data
      include Etcetera::AppStrategy
      include Comparable

      def self.new: (AppStrategyArgs args) -> instance
      def <=>: (untyped other) -> Integer?

      private

      attr_reader base_strategy: BaseStrategy::Xdg
      attr_reader unixy_name: String
    end
  end
end
