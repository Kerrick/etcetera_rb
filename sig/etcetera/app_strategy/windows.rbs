module Etcetera
  module AppStrategy
    class Windows < Data
      include Etcetera::AppStrategy
      include Comparable

      def self.new: (AppStrategyArgs args) -> instance
      def <=>: (untyped other) -> Integer?

      private

      attr_reader base_strategy: BaseStrategy::Windows
      attr_reader author_app_name_path: Pathname
    end
  end
end
