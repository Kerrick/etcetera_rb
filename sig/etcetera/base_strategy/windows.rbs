module Etcetera
  module BaseStrategy
    class Windows < Data
      include Etcetera::BaseStrategy
      include Comparable

      attr_reader home_dir: Pathname

      def self.new: (?home_dir: Pathname) -> instance
      def initialize: (?home_dir: Pathname) -> void
      def <=>: (untyped other) -> Integer?
    end
  end
end
